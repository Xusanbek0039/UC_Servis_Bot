BOT_TOKEN=your_telegram_bot_token
BOT_USERNAME=@your_bot_username
ADMIN_IDS=123456789,987654321

# MongoDB Atlas Database Configuration
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=pubg_uc_db

# Delivery Configuration: MANUAL or AUTO
DELIVERY_MODE=MANUAL

# TezCheck Payment Gateway
TEZ_BASE_URL=https://api.tezcheck.uz/api/merchant/v1
TEZ_API_KEY=your_tezcheck_api_key
TEZ_CASH_DESK_CODE=your_cash_desk_code

# bot.py checks pending payment status itself; no public webhook URL is required.

# LioGames reseller API (LioGames auto delivery requires all of these)
LIOGAMES_BASE_URL=https://distribution.liogames.com/api/v1
LIOGAMES_MEMBER_CODE=your_liogames_member_code
LIOGAMES_SECRET=your_liogames_private_secret
LIOGAMES_KEY_ID=
LIOGAMES_AUTO_DELIVERY=false
LIOGAMES_PRICE_TIER=GOLD
DEFAULT_PROFIT_PERCENT=10
DEFAULT_MAX_PRICE_BUFFER_PERCENT=25
LIOGAMES_MAX_RETRIES=3
LIOGAMES_STATUS_INTERVAL=20
LIOGAMES_STOP_ON_LOW_BALANCE=true
LOW_BALANCE_THRESHOLD=20
# Official public catalogue currently lists PUBG Global product ID 66719.
# Check the current LioGames catalogue and account tier before enabling live delivery.
LIOGAMES_VARIATIONS={"60":{"product_id":66719,"variation_id":533766},"325":{"product_id":66719,"variation_id":533768},"660":{"product_id":66719,"variation_id":533770},"1800":{"product_id":66719,"variation_id":533772},"3850":{"product_id":66719,"variation_id":533774},"8100":{"product_id":66719,"variation_id":533776}}
MAX_PROFIT_PERCENT=200
ORDER_PAYMENT_TTL_MINUTES=20
USD_RATE_URL=https://cbu.uz/uz/arkhiv-kursov-valyut/json/USD/
USD_RATE_INTERVAL_HOURS=12
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7

# Proof Channel (Isbot Kanali) Configuration
PROOF_CHANNEL_ID=-1001234567890
PROOF_CHANNEL_URL=https://t.me/your_proof_channel
PROOF_ENABLED=True
PROOF_SHOW_PRICE=True
PROOF_SHOW_PLAYER_ID=True
PROOF_HASHTAGS=True
PROOF_AUTO_POST=True

# Telegram Premium Custom Emoji IDs (Optional - leaving empty uses clean Unicode fallbacks)
# EMOJI_PROOF=
# EMOJI_ORDER=
# EMOJI_GAME=
# EMOJI_UC=
# EMOJI_PROCESSING=
# EMOJI_SUCCESS=
# EMOJI_PAYMENT=
# EMOJI_TIME=
# EMOJI_ID=

# Legacy API module port (the bot itself uses polling; no webhook is required)
WEBHOOK_PORT=8000

# ==============================================================================
# PUBG MOBILE UC BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-pubg-uc-bot-production-change-this-secret-key-32chars
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,yourdomain.com
DJANGO_SETTINGS_MODULE=config.settings.development

# Database Settings (PostgreSQL or fallback SQLite)
# Format: postgresql://user:password@localhost:5432/pubg_uc_db
DATABASE_URL=postgresql://pubg_user:pubg_secure_pass@localhost:5432/pubg_uc_db

# Redis & Cache Settings
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Telegram Bot Configuration
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
BOT_USERNAME=PubgUcServisBot
# Comma-separated list of admin Telegram IDs
ADMIN_IDS=123456789,987654321

# Webhook Configuration (for production bot and payment webhooks)
WEBHOOK_BASE_URL=https://yourdomain.com
BOT_WEBHOOK_PATH=/api/webhooks/telegram/
WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Delivery Configuration
# Mode: AUTO or MANUAL
DELIVERY_MODE=MANUAL
DEFAULT_TOPUP_PROVIDER=MOCK

# TezCheck Payment Gateway
TEZCHECK_BASE_URL=https://api.tezcheck.uz
TEZCHECK_API_KEY=your_tezcheck_api_key_here
TEZCHECK_CASH_DESK_CODE=your_cash_desk_code_here
TEZCHECK_SECRET_KEY=your_tezcheck_webhook_secret_key

# Midasbuy API Credentials
MIDASBUY_BASE_URL=https://api.midasbuy.com
MIDASBUY_API_KEY=your_midasbuy_api_key_here
MIDASBUY_SECRET=your_midasbuy_secret_here
MIDASBUY_APP_ID=your_midasbuy_app_id_here

# Fallback Manual Card Settings (Can also be managed via Django Admin)
DEFAULT_CARD_NUMBER=8600 0000 0000 1234
DEFAULT_CARD_OWNER=ALISHER VALIYEV
DEFAULT_BANK_NAME=Kapitalbank
SUPPORT_USERNAME=@PubgUcSupport
CHANNEL_USERNAME=@PubgUcNews

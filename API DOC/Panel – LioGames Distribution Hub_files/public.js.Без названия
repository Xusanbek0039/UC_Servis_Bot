      (function initProductsPanel(){
        if(!productsPageExists()){return;}
        $('body').addClass('liog-products-active');
        var $card=$('#liog-products-page .liog-prod-card');
        var defCat=''; try{defCat=String($card.data('defaultCat')||'').trim();}catch(e){}
        if(defCat){ $('.liog-prod-tab').removeClass('is-active'); $('.liog-prod-tab[data-cat="'+defCat.replace(/"/g,'')+'"]').addClass('is-active'); }
        clearSelection(); filterProducts();
        var $games=$('#liog-prod-games');
        $games.off('scroll.liogProducts').on('scroll.liogProducts',debounce(function(){
          var el=this;
          if(!el){return;}
          if(el.scrollTop + el.clientHeight >= el.scrollHeight - 90){ revealNextProductBatch(); }
        },90));

        // Page-scroll progressive loading. The previous build listened only to
        // the inner product grid, so pages where the first batch did not create
        // an internal scrollbar could never trigger another batch.
        var moreEl=document.getElementById('liog-prod-load-more');
        if(moreEl && 'IntersectionObserver' in window){
          try{
            var liogProductsAutoArmed=false;
            window.addEventListener('scroll',function(){ liogProductsAutoArmed=true; },{once:true,passive:true});
            var productMoreObserver=new IntersectionObserver(function(entries){
              entries.forEach(function(entry){
                if(liogProductsAutoArmed && entry.isIntersecting && !moreEl.hidden){ revealNextProductBatch(); }
              });
            },{root:null,rootMargin:'80px 0px',threshold:0.05});
            productMoreObserver.observe(moreEl);
          }catch(e){}
        }
      })();

      // Dashboard support-card cleanup / placement.
      (function enhanceDashboardSupportCard(){
        var search = window.location.search || '';
        if(search.indexOf('liog-tab=') !== -1){
          return;
        }

        function currentEffectiveLevel(){
          if(window.LiogamesPublic && window.LiogamesPublic.demoPreview){
            return String(window.LiogamesPublic.demoPreview.effectiveLevel || window.LiogamesPublic.demoPreview.realLevel || '').toLowerCase();
          }
          return '';
        }

        function findDashboardContent(){
          return $('.woocommerce-MyAccount-content').first();
        }

        function findSafeLegacyBlock($content){
          var $found = $();
          $content.find('h1,h2,h3,h4,h5,h6').each(function(){
            var $heading = $(this);
            if($heading.closest('.liog-dashboard-support-panel').length){
              return;
            }
            if($.trim($heading.text()).toLowerCase() !== 'special support'){
              return;
            }
            var $parents = $heading.parents('div');
            $parents.each(function(){
              var $el = $(this);
              if(!$el.closest('.woocommerce-MyAccount-content').is($content)){
                return;
              }
              var txt = $.trim($el.text()).toLowerCase();
              var looksLikeSupport = txt.indexOf('special support') !== -1 && (txt.indexOf('whatsapp') !== -1 || txt.indexOf('email') !== -1 || txt.indexOf('telegram') !== -1);
              var tooBroad = txt.indexOf('transactions') !== -1 || txt.indexOf('profile') !== -1 || txt.indexOf('available balance') !== -1 || txt.indexOf('account security') !== -1;
              if(looksLikeSupport && !tooBroad){
                $found = $el;
                return false;
              }
            });
            return !$found.length;
          });
          return $found;
        }

        function placeSupportCard(){
          var $content = findDashboardContent();
          if(!$content.length){
            return;
          }

          var level = currentEffectiveLevel();
          var $newCard = $content.find('.liog-dashboard-support-panel').first();
          var $legacyBlock = findSafeLegacyBlock($content);

          if(level === 'gold'){
            if($newCard.length){
              $newCard.removeClass('is-ready').hide();
            }
            if($legacyBlock.length){
              $legacyBlock.addClass('liog-dashboard-support-panel--hidden').hide();
            }
            return;
          }

          if(!$newCard.length){
            if($legacyBlock.length){
              $legacyBlock.removeClass('liog-dashboard-support-panel--hidden').show();
            }
            return;
          }

          var placed = false;
          if($legacyBlock.length){
            $newCard.insertAfter($legacyBlock);
            $legacyBlock.addClass('liog-dashboard-support-panel--hidden').hide();
            placed = true;
          }

          if(!placed){
            var $transactionsHeading = $content.find('h1,h2,h3,h4,h5,h6').filter(function(){
              return $.trim($(this).text()).toLowerCase() === 'transactions';
            }).first();
            if($transactionsHeading.length){
              var $anchor = $transactionsHeading.closest('div');
              while($anchor.length && !$anchor.parent().is($content)){
                var txt = $.trim($anchor.text()).toLowerCase();
                if(txt.indexOf('profile') !== -1 || txt.indexOf('available balance') !== -1 || txt.indexOf('account security') !== -1){
                  break;
                }
                $anchor = $anchor.parent();
              }
              if($anchor.length && !$anchor.is($content)){
                $newCard.insertAfter($anchor);
                placed = true;
              }
            }
          }

          if(!placed){
            $content.append($newCard);
          }

          $newCard.show().addClass('is-ready');
        }

        placeSupportCard();
        setTimeout(function(){ placeSupportCard(); }, 180);
      })();
  });
})(jQuery);
// Liogames Game Username Checker
(function($){
  $(function(){
    var $page = $('#liog-username-checker');
    if(!$page.length){ return; }

    var apiUrl = $page.data('apiUrl') || ((window.LiogamesPublic && window.LiogamesPublic.restUrl) ? window.LiogamesPublic.restUrl.replace(/\/$/, '') + '/username-check-self' : '/wp-json/liogames/v1/username-check-self');
    var nonce = (window.LiogamesPublic && window.LiogamesPublic.nonce) ? window.LiogamesPublic.nonce : '';

    function esc(str){ return $('<div>').text(String(str === null || typeof str === 'undefined' ? '' : str)).html(); }

    function syncFields(){
      var $opt = $('#liog-uc-game option:selected');
      var needsServer = parseInt($opt.attr('data-server') || '0', 10) === 1;
      var idLabel = String($opt.attr('data-id-label') || 'Game User ID');
      var serverLabel = String($opt.attr('data-server-label') || 'Server ID');
      var serverPlaceholder = String($opt.attr('data-server-placeholder') || 'Enter server id');
      var serverType = String($opt.attr('data-server-type') || 'text');
      var fixedServer = String($opt.attr('data-fixed-server') || '');
      var rawOptions = String($opt.attr('data-server-options') || '{}');
      var options = {};
      try { options = JSON.parse(rawOptions); } catch(e) { options = {}; }

      $('#liog-uc-user-label').text(idLabel);
      $('#liog-uc-server-label').text(serverLabel || 'Server ID');

      var isFixed = needsServer && serverType === 'fixed' && fixedServer !== '';
      $('#liog-uc-server-wrap').toggle(needsServer && !isFixed);

      var $input = $('#liog-uc-server-id');
      var $select = $('#liog-uc-server-select');
      $select.empty();

      if(serverType === 'select' && needsServer && !isFixed){
        Object.keys(options).forEach(function(value){
          var label = String(options[value] || value);
          $('<option>').val(value).text(label + ' (' + value + ')').appendTo($select);
        });
        $input.hide().prop('disabled', true).prop('required', false);
        $select.show().prop('disabled', false).prop('required', true);
      } else {
        $input.show().prop('disabled', !needsServer || isFixed).prop('required', needsServer && !isFixed).attr('placeholder', serverPlaceholder);
        $select.hide().prop('disabled', true).prop('required', false);
      }

      if(isFixed){
        $input.val(fixedServer);
      } else if(!needsServer){
        $input.val('');
      }
    }

    function renderResult(ok, data, message){
      var cls = ok ? 'is-success' : 'is-error';
      var html = '<div class="liog-uc-result-card '+cls+'">';
      html += '<div class="liog-uc-result-head"><strong>' + (ok ? 'Username Found' : 'Check Failed') + '</strong><span>' + esc(message || '') + '</span></div>';
      if(ok && data){
        html += '<div class="liog-uc-result-grid">';
        html += '<div><span>Game</span><strong>'+esc(data.game_name || data.game_label || data.game_id || data.game || '-')+'</strong></div>';
        if(data.tracking_id){ html += '<div><span>Tracking ID</span><strong>'+esc(data.tracking_id)+'</strong></div>'; }
        html += '<div><span>User ID</span><strong>'+esc(data.user_id || '-')+'</strong></div>';
        if(data.server_id){ html += '<div><span>Server ID</span><strong>'+esc(data.server_id)+'</strong></div>'; }
        html += '<div><span>Username</span><strong>'+esc(data.username || '-')+'</strong></div>';
        if(data.region){ html += '<div><span>Region</span><strong>'+esc(data.region)+'</strong></div>'; }
        if(typeof data.is_ban !== 'undefined' && data.is_ban !== null){ html += '<div><span>Ban Status</span><strong>'+(data.is_ban ? 'Banned' : 'Not banned')+'</strong></div>'; }
        if(data.response_ms){ html += '<div><span>Response</span><strong>'+esc(data.response_ms)+' ms'+(data.cached ? ' (cached)' : '')+'</strong></div>'; }
        html += '</div>';
      }
      html += '</div>';
      $('#liog-uc-result').html(html).show();
    }

    $('#liog-uc-game').on('change', syncFields);
    syncFields();

    $('#liog-uc-form').on('submit', function(e){
      e.preventDefault();
      var $btn = $('.liog-uc-submit');
      var $selectedGame = $('#liog-uc-game option:selected');
      var fixedServer = String($selectedGame.attr('data-fixed-server') || '');
      var serverVal = fixedServer !== '' ? fixedServer : ($('#liog-uc-server-select').is(':visible') ? $('#liog-uc-server-select').val() : $('#liog-uc-server-id').val());
      var payload = {
        game: $('#liog-uc-game').val(),
        user_id: $('#liog-uc-user-id').val(),
        server_id: serverVal
      };
      $btn.prop('disabled', true).text('Checking...');
      $('#liog-uc-result').hide().empty();

      $.ajax({
        url: apiUrl,
        method: 'POST',
        dataType: 'json',
        contentType: 'application/json',
        data: JSON.stringify(payload),
        beforeSend: function(xhr){ if(nonce){ xhr.setRequestHeader('X-WP-Nonce', nonce); } },
        success: function(res){
          if(res && res.ok){ renderResult(true, (res.data && Object.keys(res.data).length ? res.data : res), res.message || 'Username found.'); }
          else { renderResult(false, (res && res.data && Object.keys(res.data).length ? res.data : (res || {})), (res && res.message) ? res.message : 'Unable to check username.'); }
        },
        error: function(xhr){
          var msg = 'Unable to check username. Please try again.';
          var data = {};
          try {
            if(xhr.responseJSON){
              msg = xhr.responseJSON.message || msg;
              data = (xhr.responseJSON.data && Object.keys(xhr.responseJSON.data).length) ? xhr.responseJSON.data : xhr.responseJSON;
            }
          } catch(ex){}
          renderResult(false, data, msg);
        },
        complete: function(){ $btn.prop('disabled', false).text('Check Username'); }
      });
    });
  });
})(jQuery);


// V27 leaderboard tabs: switch panels client-side without page reload.
document.addEventListener('DOMContentLoaded', function(){
  document.querySelectorAll('.js-liog-leaderboard').forEach(function(wrap){
    var tabs = wrap.querySelectorAll('.liog-lb-tab[data-period]');
    var panels = wrap.querySelectorAll('.liog-leaderboard-panel[data-period-panel]');
    var label = wrap.querySelector('.js-liog-leaderboard-filter-label');
    if(!tabs.length || !panels.length){ return; }
    function activate(period){
      tabs.forEach(function(tab){
        var active = tab.getAttribute('data-period') === period;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      panels.forEach(function(panel){
        panel.classList.toggle('is-active', panel.getAttribute('data-period-panel') === period);
      });
      if(label){ label.textContent = period.toUpperCase(); }
    }
    tabs.forEach(function(tab){
      tab.addEventListener('click', function(e){
        e.preventDefault();
        activate(tab.getAttribute('data-period'));
      });
    });
    activate(wrap.getAttribute('data-default-period') || 'daily');
  });
});



      // Submit buy
      $('body').on('submit', '#liog-buy-form', function(e){
        e.preventDefault();
        resetBuyMessages();

        if(isDemoPreviewActive()){
          showBuyError(demoPreviewMessage());
          return;
        }

        var pid = parseInt($('#liog-buy-product-id').val(), 10) || 0;
        var vid = parseInt($('#liog-buy-variation-id').val(), 10) || 0;
        if(!pid){
          showBuyError('Invalid product.');
          return;
        }
        if(liogCurrentSchema && liogCurrentSchema.invalid){
          showBuyError('Product input requirements are temporarily unavailable. Please try again.');
          return;
        }

        var orderFields = {};
        var invalidField = '';
        $('#liog-buy-fields .liog-buy-order-field').each(function(){
          var $f = $(this);
          var key = String($f.attr('data-field-key') || '').trim();
          if(!key){ return; }
          var val = String($f.val() || '').trim();
          if($f.prop('required') && !val && !invalidField){ invalidField = key; }
          if(val){ orderFields[key] = val; }
        });
        if(invalidField){
          showBuyError('Please complete all required product details.');
          return;
        }

        var uidVal = String(orderFields.user_id || orderFields.player_id || orderFields.account_id || orderFields.role_id || '');
        var sidVal = String(orderFields.server_id || orderFields.server || orderFields.zone_id || orderFields.region || '');
        var lk = lockKey(pid, vid, JSON.stringify(orderFields), '');
        var wait = isLocked(lk);
        if(wait > 0){
          showBuyError('Please wait ' + wait + ' seconds to avoid duplicate orders (60s lock).');
          return;
        }

        var el = modalEls();
        if(el.$submit.length){ el.$submit.prop('disabled', true); }
        if(el.$loading.length){ el.$loading.show(); }

        var payload = {
          product_id: pid,
          variation_id: vid,
          qty: 1,
          order_fields: orderFields
        };
        // Backward-compatible top-level aliases for existing partner/order code.
        if(orderFields.user_id){ payload.user_id = orderFields.user_id; }
        else if(orderFields.player_id){ payload.player_id = orderFields.player_id; }
        if(orderFields.server_id){ payload.server_id = orderFields.server_id; }

        $.ajax({
          url: apiBase + '/order-create-self',
          method: 'POST',
          data: JSON.stringify(payload),
          contentType: 'application/json',
          dataType: 'json',
          beforeSend: function(xhr){
            if(window.LiogamesPublic && window.LiogamesPublic.nonce){
              xhr.setRequestHeader('X-WP-Nonce', window.LiogamesPublic.nonce);
            }
          },
          success: function(res){
            if(res && res.ok){
              setLock(lk);

              var d = res.data || {};
              var oid = d.order_id || res.order_id;
              var msg = (res.message) ? res.message : 'Order created';

              var html = '<div>' + escHtml(msg) + '</div>';
              if(oid){
                html += '<div style="margin-top:6px;">Order ID: <strong>' + escHtml(String(oid)) + '</strong></div>';
                var baseUrl = (window.LiogamesPublic && window.LiogamesPublic.myAccountUrl) ? String(window.LiogamesPublic.myAccountUrl) : '/my-account/';
                if(baseUrl.slice(-1) !== '/') { baseUrl += '/'; }
                html += '<div style="margin-top:8px;"><a class="button" href="' + escHtml(baseUrl + 'view-order/' + String(oid) + '/') + '">View Order</a></div>';
              }

              showBuySuccess(html);
            } else {
              var em = (res && res.message) ? res.message : 'Order failed.';
              showBuyError(em);
            }
          },
          error: function(xhr){
            var msg = 'Order failed. Please try again.';
            try {
              if(xhr && xhr.responseJSON){
                if(xhr.responseJSON.code === 'INSUFFICIENT_BALANCE'){
                  msg = xhr.responseJSON.message || 'Low balance.';
                  try {
                    var dd = xhr.responseJSON.data || {};
                    if(dd && (dd.wallet_balance !== undefined || dd.required_amount !== undefined)){
                      msg += ' (Wallet: ' + String(dd.wallet_balance) + ', Required: ' + String(dd.required_amount) + ')';
                    }
                  } catch(e){}
                } else if(xhr.responseJSON.message){
                  msg = xhr.responseJSON.message;
                }
              }
            } catch(ex){}
            showBuyError(msg);
          },
          complete: function(){
            var el2 = modalEls();
            if(el2.$submit.length){ el2.$submit.prop('disabled', false); }
            if(el2.$loading.length){ el2.$loading.hide(); }
          }
        });
      });



      function escAttrText(v){ return escHtml(String(v == null ? '' : v)); }

      function renderPanelProductOptions(pid, rows, productImg, demoPreview){
        var html='';
        rows = Array.isArray(rows) ? rows : [];
        for(var i=0;i<rows.length;i++){
          var r=rows[i]||{};
          var active=!!r.active;
          var h2hOnly=!!r.h2h_only;
          var allowed=(r.ordering_allowed !== false);
          var vid=parseInt(r.variation_id,10)||0;
          var name=String(r.name||'');
          var ids='P#'+String(pid)+(vid?' • V#'+String(vid):'')+(r.sku?' • '+String(r.sku):'');
          var buy='';
          if(h2hOnly && !allowed){ buy='<button type="button" class="button liog-buy-btn liog-buy-btn--h2h" disabled>H2H Level Required</button>'; }
          else if(active){ buy='<button type="button" class="button liog-buy-btn">'+(demoPreview?'Preview':'Buy')+'</button>'; }
          else { buy='<button type="button" class="button liog-buy-btn" disabled>Unavailable</button>'; }
          html += '<tr class="liog-prod-row" data-name="'+escAttrText(name)+'" data-pid="'+String(pid)+'" data-vid="'+String(vid)+'" data-img="'+escAttrText(productImg||'')+'" data-your-price="'+escAttrText(r.your_price||0)+'" data-your-price-label="'+escAttrText(r.your_label||'')+'" data-h2h-only="'+(h2hOnly?'1':'0')+'">'
            + '<td class="liog-prod-name"><div class="liog-prod-name__main">'+escHtml(name)+'</div><div class="liog-prod-name__meta">'+escHtml(ids)+'</div></td>'
            + '<td class="liog-prod-price" data-tier="gold" data-label="GOLD / Base">'+escHtml(r.gold_label||'—')+'</td>'
            + '<td class="liog-prod-price" data-tier="vip" data-label="VIP">'+escHtml(r.vip_label||'—')+'</td>'
            + '<td class="liog-prod-price" data-tier="h2h" data-label="H2H">'+escHtml(r.h2h_label||'—')+'</td>'
            + '<td class="liog-prod-status" data-label="Status"><span class="liog-status liog-status--'+(active?'ok':'bad')+'">'+(active?'ACTIVE':'MAINTENANCE')+'</span></td>'
            + '<td class="liog-prod-buy">'+buy+'</td></tr>';

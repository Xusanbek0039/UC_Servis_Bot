document.addEventListener('click', function(e){
  var copyBtn = e.target && e.target.closest ? e.target.closest('[data-liog-copy]') : null;
  if(copyBtn){
    e.preventDefault();
    var selector = copyBtn.getAttribute('data-liog-copy') || '';
    var target = selector ? document.querySelector(selector) : null;
    if(!target){ return; }
    var text = typeof target.value !== 'undefined' ? target.value : target.textContent;
    var done = function(){ var old=copyBtn.textContent; copyBtn.textContent='Copied'; setTimeout(function(){copyBtn.textContent=old;},1200); };
    if(navigator.clipboard && navigator.clipboard.writeText){ navigator.clipboard.writeText(String(text||'')).then(done).catch(function(){}); }
    else { var ta=document.createElement('textarea'); ta.value=String(text||''); document.body.appendChild(ta); ta.select(); try{document.execCommand('copy');done();}catch(err){} document.body.removeChild(ta); }
    return;
  }
  var revealBtn = e.target && e.target.closest ? e.target.closest('[data-liog-reveal]') : null;
  if(revealBtn){
    e.preventDefault();
    var sel = revealBtn.getAttribute('data-liog-reveal') || '';
    var input = sel ? document.querySelector(sel) : null;
    if(!input){ return; }
    var reveal = input.type === 'password';
    input.type = reveal ? 'text' : 'password';
    revealBtn.textContent = reveal ? 'Hide' : 'Reveal';
    return;
  }
  var confirmBtn = e.target && e.target.closest ? e.target.closest('[data-liog-confirm]') : null;
  if(confirmBtn){
    var msg = confirmBtn.getAttribute('data-liog-confirm') || 'Are you sure?';
    if(!window.confirm(msg)){ e.preventDefault(); e.stopPropagation(); }
  }
});


/* Core 3.6.26 — authenticated browser time-zone auto-sync.
 * Runs only when the seller has not explicitly chosen a manual time zone.
 * One lightweight REST call is made only when the detected zone needs syncing.
 */
(function(){
  'use strict';
  var cfg=window.LiogamesPublic||{};
  if(!cfg.loggedIn||!cfg.restUrl||!cfg.nonce||!cfg.timezone||!cfg.timezone.autoSync){return;}
  var zone='';
  try{zone=Intl.DateTimeFormat().resolvedOptions().timeZone||'';}catch(e){}
  if(!zone){return;}
  if(cfg.timezone.source==='browser'&&cfg.timezone.current===zone){return;}
  var syncKey='liog_tz_synced_'+zone;
  try{if(sessionStorage.getItem(syncKey)==='1'){return;}sessionStorage.setItem(syncKey,'1');}catch(e){}
  var base=String(cfg.restUrl).replace(/\/$/,'');
  fetch(base+'/account/timezone',{
    method:'POST',credentials:'same-origin',
    headers:{'Content-Type':'application/json','X-WP-Nonce':cfg.nonce},
    body:JSON.stringify({timezone:zone})
  }).then(function(r){return r.ok?r.json():Promise.reject(new Error('timezone sync failed'));})
    .then(function(data){
      if(data&&data.ok&&data.changed){
        try{
          var reloadKey='liog_tz_reloaded_'+zone;
          if(sessionStorage.getItem(reloadKey)!=='1'){
            sessionStorage.setItem(reloadKey,'1');
            window.location.reload();
          }
        }catch(e){window.location.reload();}
      }
    }).catch(function(){});
})();

/* Core 3.6.20 — seller timezone selector */
(function(){
  function selectedZone(){var el=document.getElementById('liog_timezone');return el?String(el.value||''):'';}
  function updatePreview(zone){
    var out=document.querySelector('[data-liog-timezone-preview]');var status=document.querySelector('[data-liog-timezone-status]');if(!zone){return;}
    if(status){status.innerHTML='Selected: <strong></strong>';var b=status.querySelector('strong');if(b){b.textContent=zone;}}
    if(!out||!window.Intl||!Intl.DateTimeFormat){return;}
    try{out.textContent=new Intl.DateTimeFormat(undefined,{timeZone:zone,year:'numeric',month:'short',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',timeZoneName:'short'}).format(new Date())+' · '+zone;}catch(e){}
  }
  document.addEventListener('change',function(e){if(e.target&&e.target.id==='liog_timezone'){updatePreview(selectedZone());}});
  document.addEventListener('click',function(e){var btn=e.target&&e.target.closest?e.target.closest('.liog-detect-timezone'):null;if(!btn){return;}e.preventDefault();var select=document.getElementById('liog_timezone');if(!select){return;}var zone='';try{zone=Intl.DateTimeFormat().resolvedOptions().timeZone||'';}catch(err){}if(!zone){var st=document.querySelector('[data-liog-timezone-status]');if(st){st.textContent='Browser time zone could not be detected. Choose it manually.';}return;}var option=Array.prototype.find.call(select.options,function(o){return o.value===zone;});if(option){select.value=zone;updatePreview(zone);}else{var st2=document.querySelector('[data-liog-timezone-status]');if(st2){st2.textContent='Detected '+zone+'. Choose the closest available time zone manually.';}}});
  if(document.getElementById('liog_timezone')){updatePreview(selectedZone());}
})();

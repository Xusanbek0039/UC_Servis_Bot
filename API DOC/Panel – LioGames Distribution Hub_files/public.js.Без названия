      // Username pages under existing API Integration menu
      (function setupUsernameApiMenu(){
        var $nav = $('.woocommerce-MyAccount-navigation ul').first();
        if(!$nav.length){ return; }

        var $checker = $nav.find('li.woocommerce-MyAccount-navigation-link--liog-username-checker').first();
        var $usernameDocs = $nav.find('li.woocommerce-MyAccount-navigation-link--liog-username-docs').first();
        if(!$checker.length || !$usernameDocs.length){ return; }

        // Prefer the existing API docs/integration item as the parent anchor.
        var $apiParent = $nav.children('li.woocommerce-MyAccount-navigation-link--liog-docs').first();
        if(!$apiParent.length){
          $apiParent = $nav.children('li').filter(function(){
            var txt = $.trim($(this).children('a').first().text()).toLowerCase();
            return txt === 'api integration' || txt === 'api documentation';
          }).first();
        }
        if(!$apiParent.length){ return; }

        $apiParent.addClass('liog-api-parent');

        var $submenu = $apiParent.children('ul.liog-api-submenu').first();
        if(!$submenu.length){
          $submenu = $('<ul class="liog-submenu liog-api-submenu"></ul>');
          $apiParent.append($submenu);
        }

        if(!$checker.parent().is($submenu)){ $submenu.append($checker); }
        if(!$usernameDocs.parent().is($submenu)){ $submenu.append($usernameDocs); }

        // Hide any accidental duplicate nested item labels that may have been rendered by older builds.
        $submenu.children('li').each(function(){
          var $li = $(this);
          var txt = $.trim($li.children('a').first().text()).toLowerCase();
          if(txt === 'username api integration'){
            $li.remove();
          }
        });

        var active = $checker.hasClass('is-active') || $usernameDocs.hasClass('is-active') || $apiParent.hasClass('is-active');
        $apiParent.toggleClass('liog-open', active);
        if(active){ $submenu.show(); }
      })();

      // -----------------------------------------------------------------
      // Products selector UI (Category -> Product -> Variations)
      // -----------------------------------------------------------------
      function getActiveCat(){
        var $t = $('.liog-prod-tab.is-active');
        return String($t.data('cat') || '').trim();
      }

      function chipHasCat($chip, cat){
        if(!cat){ return true; }
        var cats = String($chip.data('cats') || '');
        return ((',' + cats + ',').indexOf(',' + cat + ',') !== -1);
      }

      var liogProductsBatchSize = 25;
      var liogProductOptionsCache = {};

      function hydrateProductChip($c){
        var $img = $c.find('img[data-src]').first();
        if($img.length){
          var src = String($img.attr('data-src') || '');
          if(src){ $img.attr('src', src).removeAttr('data-src'); }
        }
      }

      function chipMatchesFilters($c){
        var query = String($('#liog-prod-search').val() || '').toLowerCase().trim();
        var cat = getActiveCat();
        var name = String($c.data('name') || '').toLowerCase();
        var pid = String($c.data('pid') || '');
        var okCat = chipHasCat($c, cat);
        var okQuery = (!query) ? true : (name.indexOf(query) !== -1 || pid.indexOf(query) !== -1);
        return okCat && okQuery;
      }

      function updateProductCounts(){
        var visible = $('.liog-game-chip').filter(function(){ return chipMatchesFilters($(this)) && !$(this).hasClass('is-lazy-deferred'); }).length;
        var total = $('.liog-game-chip').filter(function(){ return chipMatchesFilters($(this)); }).length;
        $('#liog-prod-visible-count').text(String(visible));
        $('#liog-prod-total-count').text(String(total));
        $('#liog-prod-empty').prop('hidden', total > 0);
        $('#liog-prod-games').toggleClass('is-empty', total === 0);
        var remaining = Math.max(0, total - visible);
        var $more = $('#liog-prod-load-more');
        $more.prop('hidden', total === 0 || remaining <= 0);
        $more.find('span').text(remaining > 0 ? ('Load ' + String(Math.min(liogProductsBatchSize, remaining)) + ' more products') : 'All products loaded');
        $('#liog-prod-load-more-meta').text(remaining > 0 ? (String(remaining) + ' remaining') : 'All matching products are visible');
      }

      function revealNextProductBatch(){
        var $eligible = $('.liog-game-chip.is-lazy-deferred').filter(function(){ return chipMatchesFilters($(this)); }).slice(0, liogProductsBatchSize);
        $eligible.each(function(){
          var $c=$(this); $c.removeClass('is-lazy-deferred').show(); hydrateProductChip($c);
        });
        updateProductCounts();
      }

      function resetProductBatch(){
        $('.liog-game-chip').each(function(){
          var $c=$(this);
          if(chipMatchesFilters($c)){
            $c.addClass('is-lazy-deferred').hide();
          } else {
            $c.hide();
          }
        });
        revealNextProductBatch();
      }

      function clearSelection(){
        if(!productsPageExists()){ return; }
        $('.liog-game-chip').removeClass('is-active');

(function($){
  $(function(){
    // -------------------------------------------------------------------
    // Helpers
    // -------------------------------------------------------------------
    var apiBase = (window.LiogamesPublic && window.LiogamesPublic.restUrl) ? window.LiogamesPublic.restUrl.replace(/\/$/, '') : '/wp-json/liogames/v1';
    var liogCurrentSchema = null; // last loaded product input schema
    var planInfo = (window.LiogamesPublic && window.LiogamesPublic.planInfo) ? window.LiogamesPublic.planInfo : {};
    var upgradeAmounts = (window.LiogamesPublic && window.LiogamesPublic.upgradeAmounts) ? window.LiogamesPublic.upgradeAmounts : {};
    var demoPreview = (window.LiogamesPublic && window.LiogamesPublic.demoPreview) ? window.LiogamesPublic.demoPreview : { active: 0, message: '' };

    function shouldSendNonce(){
      return !!(window.LiogamesPublic && window.LiogamesPublic.loggedIn && window.LiogamesPublic.nonce);
    }

    function isDemoPreviewActive(){
      return !!(demoPreview && parseInt(demoPreview.active || 0, 10) === 1);
    }

    function demoPreviewMessage(){
      return (demoPreview && demoPreview.message) ? String(demoPreview.message) : 'Demo Preview is active. Live actions are disabled until you switch back to your real panel.';
    }

    function showLiogamesNotice(message, type){
      message = message || 'Action blocked.';
      type = type || 'error';
      var id = 'liogames-floating-notice';
      var $box = $('#' + id);
      if(!$box.length){
        $box = $('<div/>', { id: id, 'class': 'liogames-floating-notice', 'role': 'alert', 'aria-live': 'assertive' }).appendTo('body');
      }
      $box.removeClass('is-error is-success is-info').addClass('is-' + type).text(message).addClass('is-visible');
      clearTimeout($box.data('timer'));
      $box.data('timer', setTimeout(function(){ $box.removeClass('is-visible'); }, 5200));
    }

    function showDemoPreviewAlert(){
      showLiogamesNotice(demoPreviewMessage(), 'error');
    }

    // Delegated binding: WooCommerce My Account tabs can render content dynamically.
    $('body').on('click', '#liogames-load-variations', function(){
      var pid = $('#liogames-product-select').val();
      if(!pid){ alert('Select a product'); return; }

      var $tb = $('#liogames-variations-table tbody');
      $tb.empty().append('<tr><td colspan="2">Loading...</td></tr>');

      $.ajax({
        url: apiBase + '/product-variations',
        method: 'GET',
        dataType: 'json',
        data: { product_id: pid },
        beforeSend: function(xhr){
          if(shouldSendNonce()){
            xhr.setRequestHeader('X-WP-Nonce', window.LiogamesPublic.nonce);
          }
        },
        success: function(res){
          $tb.empty();
          if(res && res.ok){
            var vars = (res.variations || (res.data && res.data.variations) || []);
            if(!vars || !vars.length){
              $tb.append('<tr><td colspan="2">No variations found.</td></tr>');
              return;
            }
            vars.forEach(function(row){
              $tb.append('<tr><td>'+row.variation_id+'</td><td>'+row.attributes+'</td></tr>');
            });
          } else {
            var msg = (res && (res.message || res.code)) ? (res.message || res.code) : 'Request failed.';
            $tb.append('<tr><td colspan="2">'+escHtml(msg)+'</td></tr>');
            alert('Error: ' + msg);
          }
        },
        error: function(xhr){
          $tb.empty();
          var msg = 'Request failed. Please try again.';
          try {
            if(xhr && xhr.responseJSON && xhr.responseJSON.message){
              msg = xhr.responseJSON.message;
            } else if(xhr && xhr.status){
              msg = 'Request failed (' + xhr.status + '). Please try again.';
            }
          } catch(ex){}
          $tb.append('<tr><td colspan="2">'+escHtml(msg)+'</td></tr>');
          alert(msg);
        }
      });
    });

    $('body').on('click', '#liogames-download-csv', function(){
      var pid = $('#liogames-product-select').val();
      if(!pid){ alert('Select a product'); return; }
      window.location = apiBase + '/product-variations?product_id='+pid+'&download=1';
    });

    // -------------------------------------------------------------------
    // Level Prices (Reseller Price List) — paginated to prevent timeouts
    // -------------------------------------------------------------------
    function escHtml(str){
      return $('<div>').text(String(str === null || typeof str === 'undefined' ? '' : str)).html();
    }

    function fmtMoney(val, symbol){
      var num = parseFloat(val);
      if(isNaN(num)){ num = 0; }
      return (symbol || '') + num.toFixed(2);
    }

    function debounce(fn, wait){
      var t = null;
      return function(){
        var ctx = this, args = arguments;
        clearTimeout(t);
        t = setTimeout(function(){ fn.apply(ctx, args); }, wait || 200);
      };
    }

    var priceLevelLabels = {
      gold: 'GOLD',
      vip: 'VIP',
      h2h: 'H2H'
    };

    var priceState = {
      pid: '',
      level: '',
      page: 1,
      perPage: 10,
      onlyAllowed: 0,
      loading: false
    };

    function getOnlyAllowed(){
      var onlyAllowed = 0;
      try {
        var tmp = $('#liogames-price-matrix').data('onlyAllowed');
        if(typeof tmp !== 'undefined' && tmp !== null && tmp !== ''){
          onlyAllowed = parseInt(tmp, 10);
          if(isNaN(onlyAllowed)){ onlyAllowed = 0; }
        }
      } catch(ex){ onlyAllowed = 0; }
      return onlyAllowed;
    }

    function normalizeLevel(level){
      level = String(level || '').toLowerCase().trim();
      return priceLevelLabels[level] ? level : '';
    }

    function getSelectedLevel(){
      return normalizeLevel($('#liog-pl-level').val());
    }

    function optionAllowedLevels($opt){
      var raw = String($opt.attr('data-allowed-levels') || '').toLowerCase().trim();
      if(!raw){ return []; }
      return raw.split(',').map(function(x){ return normalizeLevel(x); }).filter(function(x){ return !!x; });
    }

    function buildNominalCell(name, productId, variationId){
      var nm = escHtml(name || '');
      var ids = 'P#' + escHtml(productId || '') + (variationId ? (' \u2022 V#' + escHtml(variationId)) : '');
      return '<div class="liog-pl-nominal">'
        + '<div class="liog-pl-nominal__name">' + nm + '</div>'
        + '<div class="liog-pl-nominal__ids">' + ids + '</div>'
        + '</div>';
    }

    function cascadePriceLevels(level){
      level = normalizeLevel(level);
      if(level === 'gold'){ return ['gold','vip','h2h']; }
      if(level === 'vip'){ return ['vip','h2h']; }
      if(level === 'h2h'){ return ['h2h']; }
      return ['gold','vip','h2h'];
    }

    function cascadeLevelsFromAllowed(allowed){
      allowed = (allowed || []).map(function(l){ return normalizeLevel(l); }).filter(function(l){ return !!l; });
      if(allowed.indexOf('gold') !== -1){ return ['gold','vip','h2h']; }
      if(allowed.indexOf('vip') !== -1){ return ['vip','h2h']; }
      if(allowed.indexOf('h2h') !== -1){ return ['h2h']; }
      return ['gold','vip','h2h'];
    }

    function getSelectedProductAllowedLevels(){
      var $opt = $('#liogames-price-product option:selected');
      if(!$opt.length){ return []; }
      return optionAllowedLevels($opt);
    }

    function displayLevelsForCurrentSelection(res){
      var selected = getSelectedLevel();
      if(selected){ return cascadePriceLevels(selected); }

      var levels = (res && res.data && res.data.levels) ? res.data.levels : [];
      if(levels && levels.length){
        return levels.map(function(l){ return normalizeLevel(l); }).filter(function(l){ return !!l; });
      }

      return cascadeLevelsFromAllowed(getSelectedProductAllowedLevels());
    }

    function levelListFromResponse(res){
      return displayLevelsForCurrentSelection(res);
    }

    function setPriceTableHeaders(levels, h2hOnly){
      var $head = $('#liogames-price-table thead tr');
      if(!$head.length){ return; }
      levels = levels || [];
      var html = '<th>Nominal</th><th>PID</th>' + (h2hOnly ? '' : '<th>Normal Price</th>');
      levels.forEach(function(level){
        html += '<th class="liog-pl-level-head" data-level="' + escHtml(level) + '">' + escHtml(priceLevelLabels[level] || String(level).toUpperCase()) + '</th>';
      });
      $head.html(html);
    }

    function priceColspan(levels, h2hOnly){
      return (h2hOnly ? 2 : 3) + ((levels && levels.length) ? levels.length : 3);
    }

    function renderRows(rows, symbol, levels, h2hOnly){
      var html = '';
      levels = (levels && levels.length) ? levels : ['gold','vip','h2h'];
      rows.forEach(function(r){
        var productId = r.product_id || '';
        var varId = r.variation_id || 0;
        var name = r.name || '';
        var sku = r.sku || '-';
        var base = fmtMoney(r.base_price, symbol);

        html += '<tr>'
          + '<td>' + buildNominalCell(name, productId, varId) + '</td>'
          + '<td>' + escHtml(sku) + '</td>'
          + (h2hOnly ? '' : '<td>' + escHtml(base) + '</td>');

        levels.forEach(function(level){
          var price = (r.prices && typeof r.prices[level] !== 'undefined') ? r.prices[level] : '';
          html += '<td>' + escHtml(price === '' ? '-' : fmtMoney(price, symbol)) + '</td>';
        });

        html += '</tr>';
      });
      return html;
    }

    function renderPagination(page, totalPages){
      var $wrap = $('#liog-pl-pagination');
      if(!$wrap.length){ return; }
      if(!totalPages || totalPages <= 1){
        $wrap.empty();
        return;
      }

      function btn(p, label, active, disabled){
        var cls = 'liog-pl-page-btn';
        if(active){ cls += ' is-active'; }
        if(disabled){ cls += ' is-disabled'; }
        return '<button type="button" class="' + cls + '" data-page="' + escHtml(p) + '"' + (disabled ? ' disabled' : '') + '>' + escHtml(label) + '</button>';
      }

      var html = '';
      html += btn(Math.max(1, page-1), '\u2039', false, page <= 1);

      var pages = [];
      if(totalPages <= 7){
        for(var i=1;i<=totalPages;i++){ pages.push(i); }
      } else {
        pages.push(1);
        if(page > 3){ pages.push('...'); }
        var start = Math.max(2, page - 1);
        var end   = Math.min(totalPages - 1, page + 1);
        for(var j=start;j<=end;j++){ pages.push(j); }
        if(page < totalPages - 2){ pages.push('...'); }
        pages.push(totalPages);
      }

      pages.forEach(function(p){
        if(p === '...'){
          html += '<span class="liog-pl-page-ellipsis">...</span>';
        } else {
          html += btn(p, String(p), p === page, false);
        }
      });

      html += btn(Math.min(totalPages, page+1), '\u203a', false, page >= totalPages);
      $wrap.html(html);
    }

    function fetchMatrixPage(pid, page, perPage){
      var $err = $('#liogames-price-error');
      var $loading = $('#liogames-price-loading');
      var $btn = $('#liogames-load-price-matrix');
      var $tb = $('#liogames-price-table tbody');
      var symbol = $('#liogames-price-matrix').data('currency') || '';
      var selectedLevel = getSelectedLevel();
      var selectedOpt = $('#liogames-price-product option:selected');
      var selectedH2hOnly = String(selectedOpt.attr('data-h2h-only') || '0') === '1';
      var currentLevels = selectedH2hOnly ? ['h2h'] : (selectedLevel ? cascadePriceLevels(selectedLevel) : cascadeLevelsFromAllowed(getSelectedProductAllowedLevels()));

      $err.hide().text('');
      setPriceTableHeaders(currentLevels, selectedH2hOnly);

      if(!pid){
        $tb.html('<tr><td colspan="' + priceColspan(currentLevels, selectedH2hOnly) + '">Please select a product first.</td></tr>');
        renderPagination(1,1);
        return;
      }

      if(priceState.loading){ return; }

      priceState.loading = true;
      $btn.prop('disabled', true);
      $loading.show();

      var onlyAllowed = getOnlyAllowed();
      priceState.onlyAllowed = onlyAllowed;
      priceState.level = selectedLevel;

      $.ajax({
        url: apiBase + '/products/' + encodeURIComponent(pid)
          + '/price-matrix?only_allowed=' + encodeURIComponent(String(onlyAllowed))
          + '&level=' + encodeURIComponent(String(selectedLevel || ''))
          + '&page=' + encodeURIComponent(String(page || 1))
          + '&per_page=' + encodeURIComponent(String(perPage || 10)),
        method: 'GET',
        dataType: 'json',
        beforeSend: function(xhr){
          if(shouldSendNonce()){
            xhr.setRequestHeader('X-WP-Nonce', window.LiogamesPublic.nonce);
          }
        },
        success: function(res){
          if(!res || !res.ok){
            var msg = (res && res.message) ? res.message : 'Failed to load prices.';
            $err.text(msg).show();
            $tb.html('<tr><td colspan="' + priceColspan(currentLevels, selectedH2hOnly) + '">' + escHtml(msg) + '</td></tr>');
            renderPagination(1,1);
            return;
          }

          var h2hOnly = !!(res && res.data && res.data.product && res.data.product.h2h_only);
          var levels = h2hOnly ? ['h2h'] : levelListFromResponse(res);
          setPriceTableHeaders(levels, h2hOnly);

          var rows = (res.data && res.data.rows) ? res.data.rows : [];
          var pg = (res.data && res.data.pagination) ? res.data.pagination : null;

          if(!rows.length || !levels.length){
            $tb.html('<tr><td colspan="' + priceColspan(levels, h2hOnly) + '">No prices found for this product.</td></tr>');
            renderPagination(1,1);
            return;
          }

          $tb.html(renderRows(rows, symbol, levels, h2hOnly));

          if(pg && pg.total_pages){
            renderPagination(parseInt(pg.page,10) || 1, parseInt(pg.total_pages,10) || 1);
          } else {
            renderPagination(1,1);
          }
        },
        error: function(xhr){
          var msg = 'Request failed. Please try again.';
          try {
            if(xhr && xhr.responseJSON && xhr.responseJSON.message){
              msg = xhr.responseJSON.message;
            } else if(xhr && xhr.status){
              msg = 'Request failed (' + xhr.status + '). Please try again.';
            }
          } catch(ex){}
          $err.text(msg).show();
          $tb.html('<tr><td colspan="' + priceColspan(currentLevels, selectedH2hOnly) + '">' + escHtml(msg) + '</td></tr>');
          renderPagination(1,1);
        },
        complete: function(){
          priceState.loading = false;
          $btn.prop('disabled', false);
          $loading.hide();
        }
      });
    }

    function applyPriceProductFilters(){
      var $sel = $('#liogames-price-product');
      var $search = $('#liog-pl-search-product');
      if(!$sel.length || !$sel.data('liogAllOptions')){ return; }

      var all = $sel.data('liogAllOptions') || [];
      var term = String($search.val() || '').toLowerCase().trim();
      var level = getSelectedLevel();
      var cur = $sel.val();
      var hasCur = false;

      $sel.empty();
      all.forEach(function(o){
        if(!o.value){
          var $placeholder = $('<option>').val('').text(o.text).attr('data-allowed-levels', '').attr('data-h2h-only', '0');
          $sel.append($placeholder);
          return;
        }

        var textMatch = !term || String(o.text).toLowerCase().indexOf(term) !== -1;
        var levelMatch = true;
        if(level){
          levelMatch = o.allowed.indexOf(level) !== -1;
        }
        if(textMatch && levelMatch){
          var $opt = $('<option>').val(o.value).text(o.text).attr('data-allowed-levels', o.allowed.join(',')).attr('data-h2h-only', o.h2hOnly ? '1' : '0');
          $sel.append($opt);
          if(String(o.value) === String(cur)){ hasCur = true; }
        }
      });

      if(cur && hasCur){
        $sel.val(cur);
      } else if(cur && !hasCur){
        $sel.val('');
        priceState.pid = '';
        var displayLevels = level ? cascadePriceLevels(level) : ['gold','vip','h2h'];
        setPriceTableHeaders(displayLevels);
        $('#liogames-price-table tbody').html('<tr><td colspan="' + priceColspan(displayLevels) + '">Selected product is not available for this level.</td></tr>');
        renderPagination(1,1);
      }
    }

    // Keep a copy of all product options for search + level filter.
    $(function(){
      var $sel = $('#liogames-price-product');
      var $search = $('#liog-pl-search-product');
      var $level = $('#liog-pl-level');
      if($sel.length && $search.length){
        var all = [];
        $sel.find('option').each(function(){
          var $opt = $(this);
          all.push({ value: this.value, text: $opt.text(), allowed: optionAllowedLevels($opt), h2hOnly: String($opt.attr('data-h2h-only') || '0') === '1' });
        });
        $sel.data('liogAllOptions', all);

        $search.on('input', debounce(function(){
          applyPriceProductFilters();
        }, 180));

        if($level.length){
          $level.on('change', function(){
            var selectedLevel = getSelectedLevel();
            priceState.level = selectedLevel;
            priceState.page = 1;
            applyPriceProductFilters();
            var pid = $sel.val();
            var pp = parseInt($('#liog-pl-per-page').val(), 10);
            priceState.perPage = isNaN(pp) ? 10 : pp;
            if(pid){
              fetchMatrixPage(pid, 1, priceState.perPage);
            } else {
              var displayLevels = selectedLevel ? cascadePriceLevels(selectedLevel) : ['gold','vip','h2h'];
              setPriceTableHeaders(displayLevels);
              $('#liogames-price-table tbody').html('<tr><td colspan="' + priceColspan(displayLevels) + '">Select a product and click Load.</td></tr>');
              renderPagination(1,1);
            }
          });
        }
      }
    });

    $('body').on('click', '#liogames-load-price-matrix', function(){
      priceState.pid = $('#liogames-price-product').val();
      priceState.level = getSelectedLevel();
      priceState.page = 1;
      var pp = parseInt($('#liog-pl-per-page').val(), 10);
      priceState.perPage = isNaN(pp) ? 10 : pp;
      fetchMatrixPage(priceState.pid, priceState.page, priceState.perPage);
    });

    // Auto-load on product selection (UX like a reseller price list page).
    $('body').on('change', '#liogames-price-product', function(){
      var pid = $(this).val();
      if(!pid){ return; }
      priceState.pid = pid;
      priceState.level = getSelectedLevel();
      priceState.page = 1;
      var pp = parseInt($('#liog-pl-per-page').val(), 10);
      priceState.perPage = isNaN(pp) ? 10 : pp;
      fetchMatrixPage(pid, 1, priceState.perPage);
    });

    $('body').on('change', '#liog-pl-per-page', function(){
      var pid = $('#liogames-price-product').val();
      if(!pid){ return; }
      var pp = parseInt($(this).val(), 10);
      priceState.perPage = isNaN(pp) ? 10 : pp;
      priceState.page = 1;
      fetchMatrixPage(pid, 1, priceState.perPage);
    });

    $('body').on('click', '.liog-pl-page-btn', function(){
      var pid = $('#liogames-price-product').val();
      if(!pid){ return; }
      var p = parseInt($(this).data('page'), 10);
      if(isNaN(p) || p < 1){ return; }
      priceState.page = p;
      fetchMatrixPage(pid, p, priceState.perPage);
    });


    // Add Verification link to the custom profile popup without touching theme templates.
    $(function(){
      try {
        var $menus = $('.lio-g2-profile-menu__items');
        if(!$menus.length){ return; }
        $menus.each(function(){
          var $menu = $(this);
          if($menu.find('a[href*="liog-tab=verification"]').length){ return; }
          var base = window.location.href.split('#')[0];
          var clean = base.replace(/([?&])liog-tab=[^&]*/,'$1').replace(/[?&]$/,'');
          var sep = clean.indexOf('?') === -1 ? '?' : '&';
          var url = clean + sep + 'liog-tab=verification';
          var html = '<a class="lio-g2-profile-menu__item liog-profile-verification-link" href="' + url + '">'
            + '<span class="dashicons dashicons-shield-alt" aria-hidden="true"></span>'
            + '<span>Verification</span>'
            + '</a>';
          // Put it after Orders if possible; otherwise prepend.
          var $orders = $menu.find('a[href*="orders"]').first();
          if($orders.length){ $orders.after(html); } else { $menu.prepend(html); }
        });
      } catch(e){}
    });


    // -------------------------------------------------------------------
    // Upgrade request (manual approval)
    // -------------------------------------------------------------------
    $('body').on('click', '.liogames-upgrade-request-btn', function(e){
      e.preventDefault();
      var $btn = $(this);
      var level = $btn.data('level');
      if(!level){ return; }

      var $msg = $('#liogames-upgrade-message');
      if($msg.length){
        $msg.hide().empty();
      }

      $btn.prop('disabled', true).addClass('is-loading');

      $.ajax({
        url: apiBase + '/upgrade-request',
        method: 'POST',
        data: JSON.stringify({ level: level }),
        contentType: 'application/json',
        dataType: 'json',
        beforeSend: function(xhr){
          if(window.LiogamesPublic && window.LiogamesPublic.nonce){
            xhr.setRequestHeader('X-WP-Nonce', window.LiogamesPublic.nonce);
          }
        },
        success: function(res){
          var ok = !!(res && res.ok);
          var text = (res && res.message) ? res.message : (ok ? 'Request submitted' : 'Request failed');
          if($msg.length){
            $msg.html('<div class="' + (ok ? 'woocommerce-message' : 'woocommerce-error') + '">' + $('<div>').text(text).html() + '</div>').show();
          }
          if(ok){
            window.location.reload();
          }
        },
        error: function(xhr){
          var msg = 'Request failed. Please try again.';
          try {
            if(xhr && xhr.responseJSON && xhr.responseJSON.message){
              msg = xhr.responseJSON.message;
            }
          } catch(ex){}
          if($msg.length){
            $msg.html('<div class="woocommerce-error">' + $('<div>').text(msg).html() + '</div>').show();
          }
        },
        complete: function(){
          $btn.prop('disabled', false).removeClass('is-loading');
        }
      });
    });

    // -------------------------------------------------------------------
    // Products page (My Account) — level-wise list + manual buy
    // -------------------------------------------------------------------
    // NOTE: Do NOT rely on page-ready DOM existence. Some account templates
    // (or caching/optimization plugins) can replace content dynamically.
    // We therefore bind all events using delegation and resolve DOM nodes
    // at the moment the user clicks.

    function productsPageExists(){
      return $('#liog-products-page').length > 0;
    }

    function modalEls(){
      // Disable browser native pattern bubbles on the manual order form.
      // The REST API validates inputs and returns cleaner errors.
      try { $('#liog-buy-form').attr('novalidate', 'novalidate'); } catch(e){}
      return {
        $modal: $('#liogames-buy-modal'),
        $fields: $('#liog-buy-fields'),
        $err: $('#liog-buy-error'),
        $ok: $('#liog-buy-success'),
        $loading: $('#liog-buy-loading'),
        $submit: $('#liog-buy-submit')
      };
    }

    function openModal(){
      var el = modalEls();
      if(el.$modal.length){
        el.$modal.addClass('is-open');
      }
    }
    function closeModal(){
      var el = modalEls();
      if(el.$modal.length){
        el.$modal.removeClass('is-open');
      }
    }

    function resetBuyMessages(){
      var el = modalEls();
      if(el.$err.length){ el.$err.hide().empty(); }
      if(el.$ok.length){ el.$ok.hide().empty(); }
    }

    function showBuyError(msg){
      resetBuyMessages();
      var el = modalEls();
      if(el.$err.length){
        el.$err.html('<div class="woocommerce-error">' + escHtml(msg || 'Something went wrong') + '</div>').show();
      } else {
        alert(msg || 'Something went wrong');
      }
    }
    function showBuySuccess(html){
      resetBuyMessages();
      var el = modalEls();
      if(el.$ok.length){
        el.$ok.html('<div class="woocommerce-message">' + html + '</div>').show();
      }
    }

      function serverLabelFromValue(v){
        if(!v){ return v; }
        v = String(v);
        var vv = v.toLowerCase();
        if(vv.indexOf('asia') !== -1){ return 'Asia'; }
        if(vv.indexOf('usa') !== -1 || vv.indexOf('america') !== -1){ return 'America'; }
        if(vv.indexOf('eur') !== -1 || vv.indexOf('euro') !== -1){ return 'Europe'; }
        if(vv.indexOf('cht') !== -1 || vv.indexOf('tw') !== -1 || vv.indexOf('hk') !== -1){ return 'TW, HK, MO'; }
        return v;
      }

      function getSchemaField(schema, key){
        try {
          if(!schema || !Array.isArray(schema.fields)){
            return null;
          }
          for(var i=0;i<schema.fields.length;i++){
            var f = schema.fields[i];
            if(f && String(f.key || '') === String(key)){
              return f;
            }
          }
        } catch(e){}
        return null;
      }

      function safeText(v, fallback){
        var s = '';
        try { s = String(v || ''); } catch(e){ s = ''; }
        s = s.trim();
        return s || fallback;
      }

      function renderSchema(schema){
        var el = modalEls();
        schema = schema || {};
        liogCurrentSchema = schema;

        var fields = Array.isArray(schema.fields) ? schema.fields : [];
        var fixedUid = (schema && schema.fixed_user_id) ? String(schema.fixed_user_id) : '';
        var html = '';

        if(fixedUid){
          html += '<input type="hidden" class="liog-buy-order-field" data-field-key="user_id" value="' + escHtml(fixedUid) + '">';
        }

        for(var i=0;i<fields.length;i++){
          var f = fields[i] || {};
          var key = String(f.key || '').trim();
          if(!key || !/^[a-zA-Z0-9_-]+$/.test(key)){ continue; }

          var label = safeText(f.label, key.replace(/_/g, ' '));
          var type = String(f.type || 'text').toLowerCase();
          var required = (f.required !== false);
          var placeholder = safeText(f.placeholder, 'Enter ' + label);
          var pattern = safeText(f.pattern, '');
          var inputmode = safeText(f.inputmode, pattern && pattern.indexOf('\\d') !== -1 ? 'numeric' : 'text');
          var id = 'liog-buy-field-' + key.replace(/[^a-zA-Z0-9_-]/g, '-');

          html += '<div class="form-row form-row-wide liog-buy-field-row" data-field-row="' + escHtml(key) + '">';
          html += '<label for="' + escHtml(id) + '">' + escHtml(label) + (required ? ' <span class="required">*</span>' : '') + '</label>';

          if(type === 'select' && Array.isArray(f.options) && f.options.length){
            html += '<select id="' + escHtml(id) + '" class="liog-buy-order-field" data-field-key="' + escHtml(key) + '"' + (required ? ' required' : '') + '>';
            html += '<option value="">Select ' + escHtml(label) + '</option>';
            for(var j=0;j<f.options.length;j++){
              var o = f.options[j] || {};
              var val = safeText(o.value, '');
              var lab = safeText(o.label, val);
              if(!val){ continue; }
              html += '<option value="' + escHtml(val) + '">' + escHtml(lab) + '</option>';
            }
            html += '</select>';
          } else {
            html += '<input type="text" id="' + escHtml(id) + '" class="liog-buy-order-field" data-field-key="' + escHtml(key) + '" placeholder="' + escHtml(placeholder) + '" autocomplete="off" inputmode="' + escHtml(inputmode) + '"' + (pattern ? ' pattern="' + escHtml(pattern) + '"' : '') + (required ? ' required' : '') + '>';
          }

          if(f.hint){
            html += '<small class="liog-buy-field-hint">' + escHtml(String(f.hint)) + '</small>';
          }
          html += '</div>';
        }

        if(!fields.length && !fixedUid){
          html = '<div class="form-row form-row-wide" style="padding:8px 0; color:#8fa0b8;">No additional account details are required for this product.</div>';
        }

        if(el.$fields.length){
          el.$fields.html(html);
        }
      }

      function loadSchema(productId, variationId){
        var el = modalEls();
        if(el.$fields.length){
          el.$fields.html('<div style="padding:8px 0; color:#666;">Loading inputs...</div>');
        }
        $.ajax({
          url: apiBase + '/product-schema',
          method: 'GET',
          dataType: 'json',
          data: {
            product_id: productId,
            variation_id: variationId || 0
          },
          beforeSend: function(xhr){
            if(shouldSendNonce()){
              xhr.setRequestHeader('X-WP-Nonce', window.LiogamesPublic.nonce);
            }
          },
          success: function(res){
            var schema = (res && res.data && res.data.schema) ? res.data.schema : null;
            if(schema && res && res.data && res.data.profile){
              schema.profile = String(res.data.profile);
            }
            if(!schema){
              liogCurrentSchema = { invalid: true };
              if(el.$fields.length){ el.$fields.html('<div class="woocommerce-error">Product input requirements are temporarily unavailable. Please try again.</div>'); }
              return;
            }
            renderSchema(schema);
          },
          error: function(){
            liogCurrentSchema = { invalid: true };
            if(el.$fields.length){ el.$fields.html('<div class="woocommerce-error">Product input requirements are temporarily unavailable. Please try again.</div>'); }
          }
        });
      }

      function lockKey(pid, vid, uid, sid){
        return 'liog_lock_' + String(pid) + '_' + String(vid || 0) + '_' + String(uid || '') + '_' + String(sid || '');
      }
      function isLocked(key){
        try {
          var ts = parseInt(localStorage.getItem(key), 10);
          if(!ts){ return 0; }
          var now = Date.now();
          var diff = Math.floor((now - ts) / 1000);
          if(diff < 60){
            return 60 - diff;
          }
          localStorage.removeItem(key);
        } catch(e){}
        return 0;
      }
      function setLock(key){
        try { localStorage.setItem(key, String(Date.now())); } catch(e){}
      }


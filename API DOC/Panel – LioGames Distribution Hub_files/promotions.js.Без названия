(function(){'use strict';function pad(n){return String(n).padStart(2,'0')}function tick(el){var exp=parseInt(el.getAttribute('data-expires')||'0',10)*1000;if(!exp)return;var now=Date.now(),left=Math.max(0,exp-now),sec=Math.floor(left/1000),d=Math.floor(sec/86400);sec%=86400;var h=Math.floor(sec/3600);sec%=3600;var m=Math.floor(sec/60),s=sec%60;el.textContent=(d>0?d+'d ':'')+pad(h)+':'+pad(m)+':'+pad(s);if(left<=0&&!el.dataset.expired){el.dataset.expired='1';el.textContent='Expired';setTimeout(function(){window.location.reload()},800)}}function start(){document.querySelectorAll('[data-liog-promo-countdown]').forEach(function(el){tick(el);setInterval(function(){tick(el)},1000)})}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',start)}else{start()}})();

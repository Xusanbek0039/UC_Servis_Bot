  ready(function(){
    initAll(document);
    document.addEventListener('click',function(e){var btn=e.target.closest('.liog-copy-btn[data-copy]');if(!btn)return;e.preventDefault();var value=btn.getAttribute('data-copy')||'';if(!value)return;var old=btn.textContent;function done(){btn.textContent='Copied';window.setTimeout(function(){btn.textContent=old||'Copy';},1200);}if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(value).then(done).catch(function(){});}});

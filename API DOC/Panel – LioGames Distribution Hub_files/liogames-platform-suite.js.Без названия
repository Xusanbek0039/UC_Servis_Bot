  function initToggle(root){(root||document).querySelectorAll('[data-liog-toggle]').forEach(function(btn){if(btn.dataset.liogBound)return;btn.dataset.liogBound='1';btn.addEventListener('click',function(){var el=document.querySelector(btn.getAttribute('data-liog-toggle'));if(!el)return;el.hidden=!el.hidden;if(!el.hidden){var first=el.querySelector('input,select,textarea');if(first)first.focus();}});});}

  function initAll(root){initToggle(root);initKb(root);initCards(root);initPlayground(root);}
  function fragmentSelector(){if(document.querySelector('.woocommerce-MyAccount-content'))return '.woocommerce-MyAccount-content';if(document.querySelector('.liog-support-hub'))return '.liog-support-hub';if(document.querySelector('.liog-suite-shell'))return '.liog-suite-shell';return '';}
  async function refreshFragment(){
